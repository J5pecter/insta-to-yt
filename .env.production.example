# ============================================================
#  SocialRelay V3 — Production Cloud Environment Template
#  Copy to .env.production on the server and generate strong secrets.
#  NEVER commit .env.production to GitHub.
# ============================================================

ENVIRONMENT=production
DOMAIN=socialrelay.skypatrol.online
PUBLIC_BASE_URL=https://socialrelay.skypatrol.online
ALLOWED_ORIGINS=https://socialrelay.skypatrol.online
SECURE_COOKIES=true
USER_TIMEZONE=Asia/Kolkata

# --- Administrator & Cryptographic Secrets ------------------
# Generate ADMIN_PASSWORD securely via scripts/setup-admin.sh
ADMIN_EMAIL=admin@skypatrol.online
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
SESSION_SECRET=CHANGE_ME_GENERATE_64_HEX_CHARS
ENCRYPTION_MASTER_KEY=CHANGE_ME_GENERATE_FERNET_KEY
JWT_EXPIRE_MINUTES=720

# --- Persistent Cloud Storage Paths -------------------------
SOCIALRELAY_DATA_DIR=/var/lib/socialrelay/data
SOCIALRELAY_STORAGE_DIR=/var/lib/socialrelay/storage
MAX_UPLOAD_SIZE_MB=500
DISK_FREE_MIN_MB=2048
TEMP_RETENTION_HOURS=24

# --- Worker & Resource Optimization -------------------------
ENABLE_EMBEDDED_WORKER=false
WORKER_CONCURRENCY=1
FFMPEG_CONCURRENCY=1
AI_PROVIDER=deterministic

# --- OAuth Redirect URIs (auto-derived from PUBLIC_BASE_URL if omitted) ---
YOUTUBE_REDIRECT_URI=https://socialrelay.skypatrol.online/api/v1/accounts/youtube/callback
INSTAGRAM_REDIRECT_URI=https://socialrelay.skypatrol.online/api/v1/accounts/instagram/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
