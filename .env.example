# ============================================================
#  SocialRelay — Self-Hosted Social Media Automation Platform
#  Copy this file to ".env" then fill in your configuration.
#  Never commit your .env file to public version control.
# ============================================================

# --- Admin Authentication & Security ------------------------
ADMIN_EMAIL=admin@socialrelay.local
ADMIN_PASSWORD=admin1234
SESSION_SECRET=change-this-to-a-very-secure-random-string-at-least-32-chars
# 32-byte urlsafe base64 key for Fernet token encryption at rest
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=CHANGE_ME_GENERATE_WITH_FERNET_KEY
JWT_EXPIRE_MINUTES=1440
USER_TIMEZONE=Asia/Kolkata

# --- Server & Networking ------------------------------------
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,http://127.0.0.1:8000,http://127.0.0.1:5173

# --- Storage & Directories ----------------------------------
DATA_DIR=data
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=500
DISK_FREE_MIN_MB=1024
TEMP_RETENTION_HOURS=24
UNUSED_DERIVATIVE_RETENTION_DAYS=30

# --- Database -----------------------------------------------
DATABASE_URL=sqlite:///data/socialrelay.db

# --- YouTube Integration (Google Cloud Console OAuth 2.0) ---
GOOGLE_CLIENT_SECRET_FILE=data/client_secret.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/accounts/youtube/callback
DEFAULT_PRIVACY=private
YOUTUBE_CATEGORY_ID=24
MADE_FOR_KIDS=false

# --- Instagram Integration (Meta Developer App) -------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/accounts/instagram/callback
INSTAGRAM_TOKEN_TYPE=business

# --- Local AI (Ollama) & Metadata Engine --------------------
# Mode: deterministic (free/offline), local (Ollama), claude (optional)
AI_PROVIDER=deterministic
OLLAMA_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=

# --- Worker & Automation Engine -----------------------------
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=300
MAX_JOB_RETRIES=5
SCHEDULER_HEARTBEAT_SECONDS=30
MISSED_JOB_POLICY=run_when_service_returns

# --- Default Publication Styling ----------------------------
DEFAULT_HASHTAGS=#shorts
INCLUDE_SOURCE_CREDIT=true
DESCRIPTION_FOOTER=
