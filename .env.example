# ============================================================
#  Insta to YouTube - settings
#  Copy this file to ".env" (start.bat does it for you), then fill it in.
#  Never share your .env file - it holds your passwords and keys.
# ============================================================

# --- Admin login (required) ---------------------------------
# The password you type to open the dashboard. At least 8 characters.
ADMIN_PASSWORD=admin1234

# --- AI: who generates the titles and descriptions ----------
# AI_PROVIDER=free    No AI key needed, no cost. Automatically extracts titles/captions/hashtags.
# AI_PROVIDER=local   Free local AI running on this PC (needs Ollama).
# AI_PROVIDER=claude  Paid Claude AI. Needs ANTHROPIC_API_KEY.
AI_PROVIDER=free

# Local AI model (if AI_PROVIDER=local).
LOCAL_AI_MODEL=gemma3:4b
OLLAMA_URL=http://127.0.0.1:11434

# Paid AI (if AI_PROVIDER=claude). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- YouTube --------------------------------------------------
# The OAuth client secret file from Google Cloud Console.
GOOGLE_CLIENT_SECRET_FILE=data/client_secret.json
# private / unlisted / public.
DEFAULT_PRIVACY=private
# 24 = Entertainment, 22 = People & Blogs
YOUTUBE_CATEGORY_ID=24
MADE_FOR_KIDS=false

# --- How the uploader behaves ---------------------------------
# true = upload automatically when ready. false = wait for manual review.
AUTO_UPLOAD=true
# true = hold non-ASMR videos for review. false = upload all videos.
HOLD_NON_ASMR=false
# true = add "Original: <instagram link> (by @account)" to the description.
INCLUDE_SOURCE_CREDIT=true
# true = keep the downloaded video files in data/downloads after upload.
# false = delete temporary download immediately after upload.
KEEP_DOWNLOADS=false

# --- Your channel style ----------------------------------------
CHANNEL_NAME=
# Added to description (space separated, e.g. #shorts)
DEFAULT_HASHTAGS=#shorts
# Text added at the end of every description. Use \n for a new line.
DESCRIPTION_FOOTER=

# --- Only if Instagram asks for a login ------------------------
INSTAGRAM_COOKIES_FILE=
INSTAGRAM_COOKIES_FROM_BROWSER=

# --- Advanced -------------------------------------------------
PORT=8000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=data
