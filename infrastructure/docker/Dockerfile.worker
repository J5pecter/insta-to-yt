FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api/ ./api/

RUN mkdir -p /app/data /app/storage/originals /app/storage/processed /app/storage/thumbnails /app/storage/temporary /app/storage/backups

CMD ["python", "-m", "api.app.workers.runner"]
