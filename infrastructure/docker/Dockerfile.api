FROM python:3.11-slim

WORKDIR /app

# Install ffmpeg, sqlite3, and curl (ARM64 & x86_64 compatible)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    sqlite3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api/ ./api/

# Create mount points only — runtime data & media stay on persistent host volumes
RUN mkdir -p /app/data /app/storage/originals /app/storage/processed /app/storage/thumbnails /app/storage/temporary /app/storage/backups

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "api.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
